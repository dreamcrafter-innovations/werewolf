{
  "expo": {
    "name": "Nightfall: Secret Roles",
    "slug": "nightfall",
    "version": "1.0.0",
    "description": "The ultimate offline party game of deception, strategy, and survival.",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0B0B1E",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0B0B1E"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.dreamcrafterinnovations.nightfall",
      "buildNumber": "1"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0B0B1E"
      },
      "package": "com.dreamcrafterinnovations.nightfall",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1
    },
    "web": { "bundler": "metro", "favicon": "./assets/favicon.png" },
    "plugins": [
      "@react-native-firebase/app",
      "@react-native-firebase/crashlytics"
    ]
  }
}
